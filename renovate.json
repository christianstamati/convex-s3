{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":maintainLockFilesWeekly"
  ],
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "description": "Merge non-major updates of stable packages once CI passes",
      "matchUpdateTypes": ["minor", "patch", "digest", "lockFileMaintenance"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "groupName": "TanStack",
      "matchPackageNames": ["@tanstack/**"]
    },
    {
      "groupName": "Convex",
      "matchPackageNames": [
        "convex",
        "convex-test",
        "convex-helpers",
        "@convex-dev/**"
      ]
    },
    {
      "groupName": "Tailwind CSS",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/**"]
    },
    {
      "description": "Nitro v3 is in beta: review every update by hand",
      "matchPackageNames": ["nitro"],
      "automerge": false
    }
  ]
}
